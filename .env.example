# ─────────────────────────────────────────────────────────────
# Germa Field Management — Environment variables
# Copy this file to `.env` and fill in your real values.
# NEVER commit your real `.env` to Git.
# ─────────────────────────────────────────────────────────────

# Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=

# Supabase public anon key (Settings → API → anon public)
# The SERVICE_ROLE key must NEVER be used in the frontend.
VITE_SUPABASE_ANON_KEY=

# Mapbox public access token (https://account.mapbox.com/access-tokens/)
VITE_MAPBOX_ACCESS_TOKEN=
